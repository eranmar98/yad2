# Copy to .env and fill in. Expo only exposes vars prefixed with EXPO_PUBLIC_ to app code.

# Base URL of the server's /api routes. "localhost" only works when running in a web/iOS
# simulator on the same machine as the server — an Android emulator needs 10.0.2.2 instead of
# localhost, and a physical device needs your machine's LAN IP (e.g. http://192.168.1.20:3000/api).
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api
EXPO_PUBLIC_GEMINI_API_KEY=AQ.Ab8RN6JSUCqj2Y86xOeA_kL2opf2Ln33xWxHETpe7opvV-Y5BQ
